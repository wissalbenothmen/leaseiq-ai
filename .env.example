SECRET_KEY=your-secure-secret-key-at-least-32-chars
DEBUG=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leaseiq
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-azure-di-key-here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=lease-documents

# Clause risk thresholds
CLAUSE_RISK_HIGH_THRESHOLD=70.0
CLAUSE_RISK_MEDIUM_THRESHOLD=40.0
CRITICAL_DATE_ALERT_DAYS=[7,30,60,90]
OBLIGATION_OVERDUE_ALERT_DAYS=1

VITE_API_BASE_URL=http://localhost:8022
